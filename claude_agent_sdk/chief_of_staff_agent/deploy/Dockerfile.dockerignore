# Build context is chief_of_staff_agent/. Keep the image lean and don't bake in
# runtime output or local state.
**/.env
**/__pycache__
**/.ipynb_checkpoints
**/*.ipynb
**/.DS_Store
**/.git
# Runtime outputs — regenerated by the agent, no reason to ship them.
output_reports/
audit/
# Deploy-tier extras that don't belong in the image.
deploy/fly/
deploy/README.md
deploy/.env.example
