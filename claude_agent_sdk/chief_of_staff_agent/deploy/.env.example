# Copy to .env and fill in. .env is gitignored — never commit a real key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Public deployments (Fly.io) MUST set this — the server then requires
# `Authorization: Bearer <token>` on /sessions/*. Generate with:
#   openssl rand -base64 32
AGENT_AUTH_TOKEN=

# Optional overrides:
# MODEL=claude-sonnet-4-6      # default is claude-opus-4-6 (what the notebook uses)
# PERMISSION_MODE=default      # or acceptEdits
